<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	  The machine readable form of the "Data Not Collected" answer given in App
	  Store Connect. Every array is deliberately empty:

	  NSPrivacyAccessedAPITypes is empty because the app uses no required reason
	  API. The journal persists through WebKit localStorage inside the WKWebView,
	  not NSUserDefaults, and none of the seven Capacitor plugins reaches for file
	  timestamps, boot time, disk space or the active keyboard. @capacitor/preferences,
	  the plugin that would force an NSPrivacyAccessedAPICategoryUserDefaults entry
	  with reason CA92.1, is deliberately not a dependency.

	  Capacitor and Cordova ship their own manifests inside their frameworks, so
	  this file covers the app target only.

	  When Supabase lands in v1.5 this file, privacy.html and the App Store Connect
	  answers all have to be rewritten together.
	-->
	<key>NSPrivacyTracking</key>
	<false/>
	<key>NSPrivacyTrackingDomains</key>
	<array/>
	<key>NSPrivacyCollectedDataTypes</key>
	<array/>
	<key>NSPrivacyAccessedAPITypes</key>
	<array/>
</dict>
</plist>
